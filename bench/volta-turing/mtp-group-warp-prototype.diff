+// Four independent output rows per CTA, one physical warp per row. Each lane replays the four virtual-warp
+// partials of native_mmvq_multi_kernel<F, NCOLS, 4, 2> in their original per-thread order, then combines them
+// in virtual-warp order before the same warp_sum. No cross-warp scratch or barrier is needed; every result must
+// retain the exact multi-column/single-column bit pattern.
+template<typename F, int NCOLS>
+__launch_bounds__(WARPS * WARP)
+__global__ void native_mtp_warp_rows_kernel(const typename F::Block* __restrict__ w, const Q81Block* __restrict__ x,
+                                            float* __restrict__ y, int n_in, int n_out) {
+    const int warp = int(threadIdx.y), lane = int(threadIdx.x);
+    const int row = int(blockIdx.x) * WARPS + warp;
+    if (row >= n_out) return;
+    const int blocks_per_row = n_in / F::DIV;
+    const int x_stride = n_in / Q8K;
+    float tmp[NCOLS][WARPS] = {};
+#pragma unroll
+    for (int v = 0; v < WARPS; ++v) {
+        const int kqs = F::kqs(v * WARP + lane);
+        for (int kbx = (v * WARP + lane) / F::T; kbx < blocks_per_row; kbx += F::BPI) {
+            const typename F::W wv = F::load(w + std::size_t(row) * blocks_per_row + kbx, kqs);
+#pragma unroll
+            for (int j = 0; j < NCOLS; ++j)
+                tmp[j][v] += F::apply(wv, x + std::size_t(j) * x_stride + kbx * F::KBY, kqs);
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < NCOLS; ++j) {
+#pragma unroll
+        for (int v = 1; v < WARPS; ++v) tmp[j][0] += tmp[j][v];
+        const float sum = warp_sum(tmp[j][0]);
+        if (lane == 0) y[std::size_t(j) * n_out + row] = sum;
+    }
+}
